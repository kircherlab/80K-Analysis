# Local staging area for large external downloads (GTEx / UKBB / ReMap / gencode ...)
# Only the small subset_* sample files derived from these are committed.
cCRE_based_analysis/data/downloading/
**/*.zip
**/*.tar.gz

# Windows "downloaded from the internet" marker files
*:Zone.Identifier

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Full (untracked) external releases — keep only subset_* samples in git
**/GTEx_49tissues_release1.tsv.bgz
**/GTEx_49tissues_release1.tsv.gz.tbi
**/UKBB_94traits_release1.bed.gz
**/UKBB_94traits_release1.cols
**/remap2022_nr_macs2_hg38*.bed.gz

